// Firestore Security Rules for timeaudit — see SETUP.md "Locking it down".
//
// Public read (the site is a public browsable database), no client write.
// Writes go through db.js push/delete via the Firebase Admin SDK (a service
// account, see lib/store-admin.js), which bypasses these rules entirely —
// that's the only way to write once this is deployed.
//
// Apply this either by pasting it into the Firebase console
// (Firestore Database -> Rules -> publish) or, with the Firebase CLI
// installed and `firebase use <project-id>` run once:
//   firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /chronology_documents/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
