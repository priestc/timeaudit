# Copy this file to .env and fill in the values from your Firebase project's
# web app config (Firebase console -> Project settings -> Your apps -> </>).
# See SETUP.md for the step-by-step walkthrough.
#
# Roadtripapp uses the same values but with a NEXT_PUBLIC_ prefix (Next.js
# requirement); this project is plain Node, so the names are unprefixed.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional overrides
# FIRESTORE_COLLECTION=chronology_documents
# TIMEAUDIT_SOURCE=firestore      # make serve.js read from Firestore instead of disk

# --- `timeaudit <url>` report generator (see PIPELINE.md) ---
# Contact email for the Unpaywall open-access lookup. Optional but strongly
# recommended: it roughly doubles how many cited sources can be downloaded.
# TIMEAUDIT_CONTACT_EMAIL=you@example.org
# ANTHROPIC_API_KEY=sk-ant-...    # enables the optional AI gap-filler
# TIMEAUDIT_AI_MODEL=claude-opus-5
# TIMEAUDIT_TANK2_HOST=tank2
# TIMEAUDIT_TANK2_DIR=/home/chris/timeaudit
