# Copy this file to .env and fill in the values from your Firebase project's
# web app config (Firebase console -> Project settings -> Your apps -> </>).
# See SETUP.md for the step-by-step walkthrough.
#
# Roadtripapp uses the same values but with a NEXT_PUBLIC_ prefix (Next.js
# requirement); this project is plain Node, so the names are unprefixed.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional overrides
# FIRESTORE_COLLECTION=chronology_documents
# TIMEAUDIT_SOURCE=firestore      # make serve.js read from Firestore instead of disk
# TIMEAUDIT_PUBLIC=1              # read-only mode for a public deploy — see DEPLOY.md

# Firebase Admin SDK service-account key, needed for `node db.js push`/`delete`
# once Firestore Security Rules deny client-SDK writes (see DEPLOY.md /
# SETUP.md "Locking it down"). Point this at the JSON key file Firebase gives
# you (Project settings -> Service accounts -> Generate new private key) —
# keep that file OUTSIDE this repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- `timeaudit <url>` report generator (see PIPELINE.md) ---
# Contact email for the Unpaywall open-access lookup. Optional but strongly
# recommended: it roughly doubles how many cited sources can be downloaded.
# TIMEAUDIT_CONTACT_EMAIL=you@example.org
# Google Books API key (free — console.cloud.google.com, enable "Books API",
# make an API key). Metadata enrichment queries Google Books first; the keyless
# quota is a small shared per-day pool that is often already exhausted, so
# without a key that step mostly logs a rate-limit and moves on.
# GOOGLE_BOOKS_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...    # enables the optional AI gap-filler
# TIMEAUDIT_AI_MODEL=claude-opus-5
# TIMEAUDIT_TANK2_HOST=tank2
# TIMEAUDIT_TANK2_DIR=/home/chris/timeaudit
